<!-- Rendered from the app's data/config.json by app/icecast_server.py.
     Placeholders: ${ICECAST_SOURCE_PASSWORD}, ${ICECAST_ADMIN_PASSWORD},
     ${ICECAST_RELAY_PASSWORD}, ${ICECAST_PORT}, ${ICECAST_HOSTNAME},
     ${ICECAST_MOUNT}, ${ICECAST_STREAM_NAME}. The structure mirrors the Debian
     icecast2 default (which accepts MP3 sources); the <security><changeowner>
     block lets icecast2 -b drop to nobody so MP3 mounts serve correctly. -->
<icecast>
  <location>Earth</location>
  <admin>icemaster@localhost</admin>

  <limits>
    <clients>100</clients>
    <sources>2</sources>
    <queue-size>524288</queue-size>
    <client-timeout>30</client-timeout>
    <header-timeout>15</header-timeout>
    <source-timeout>10</source-timeout>
    <!-- Burst on connect so players buffer quickly (standard Icecast default). -->
    <burst-on-connect>1</burst-on-connect>
    <burst-size>65535</burst-size>
  </limits>

  <authentication>
    <source-password>${ICECAST_SOURCE_PASSWORD}</source-password>
    <relay-password>${ICECAST_RELAY_PASSWORD}</relay-password>
    <admin-user>admin</admin-user>
    <admin-password>${ICECAST_ADMIN_PASSWORD}</admin-password>
  </authentication>

  <hostname>${ICECAST_HOSTNAME}</hostname>
  <listen-socket>
    <port>${ICECAST_PORT}</port>
    <bind-address>0.0.0.0</bind-address>
  </listen-socket>

  <!-- Allow embedding / cross-origin status reads (same as Debian default). -->
  <http-headers>
    <header name="Access-Control-Allow-Origin" value="*" />
  </http-headers>

  <fileserve>1</fileserve>
  <paths>
    <basedir>/usr/share/icecast2</basedir>
    <logdir>/tmp/icecast</logdir>
    <webroot>/usr/share/icecast2/web</webroot>
    <adminroot>/usr/share/icecast2/admin</adminroot>
  </paths>
  <logging>
    <accesslog>access.log</accesslog>
    <errorlog>error.log</errorlog>
    <loglevel>3</loglevel>
    <logsize>10000</logsize>
  </logging>

  <!-- Explicit /virtualdj mount, declared as MP3 so Icecast registers the
       source correctly (combined with /etc/mime.types this makes the mount
       serve to listeners). -->
  <mount>
    <mount-name>/virtualdj</mount-name>
    <mount-type>7</mount-type>
    <stream-name>${ICECAST_STREAM_NAME}</stream-name>
    <stream-genre>Various</stream-genre>
    <stream-description>Self-hosted personal radio</stream-description>
    <public>0</public>
  </mount>

  <!-- Drop privileges after start (same as the Debian systemd setup: icecast
       starts as root and changeowner switches to an unprivileged user). This is
       required for MP3 source mounts to register and serve correctly. -->
  <security>
    <chroot>0</chroot>
    <changeowner>
      <user>nobody</user>
      <group>nogroup</group>
    </changeowner>
  </security>
</icecast>
