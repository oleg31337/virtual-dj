# Virtual DJ - Docker Compose configuration
#
# Copy this file to `.env` and edit. All values are optional; the defaults
# (shown) are sensible for a first run. Only MUSIC_DIR needs a real path.

# Host port the web UI / stream is published on.
HTTP_PORT=8420

# Absolute path on the DOCKER HOST to your music library. Mounted read-only
# into the container at /music. The app's "music_dir" defaults to /music
# (the in-container mount point); change it via the web UI Library panel only
# if you also changed where the music is mounted.
MUSIC_DIR=/mnt/mp3

# Log verbosity: debug | info | warning | error
VDJ_LOG_LEVEL=info

# --- Icecast (external players: Winamp / VLC / Sonos) ---
# The app runs a managed Icecast2 server in the same container and relays the
# broadcast into it. These set the Icecast listen port and the port published
# to the host. IMPORTANT: the published host port (left of the colon in the
# compose `ports:` mapping) MUST equal ICECAST_PORT, otherwise external players
# can't reach the mount. Change all three together if you move off 8008
# (e.g. to avoid a Portainer / other-service conflict on 8008).
ICECAST_PORT=8008
# Mountpoint the relay publishes to (the .../virtualdj part of the URL).
ICECAST_MOUNT=virtualdj
# Source (relay) password the pusher uses to connect to Icecast. Change it from
# the default for any non-local exposure.
ICECAST_SOURCE_PASSWORD=hackme
# Icecast's own admin (status/metadata) and relay passwords. Leave blank for the
# defaults: admin = "admin", relay = same as ICECAST_SOURCE_PASSWORD. Both are
# only reachable on the container's loopback interface, so changing them is
# optional hardening.
# ICECAST_ADMIN_PASSWORD=
# ICECAST_RELAY_PASSWORD=
# Hostname Icecast reports in its status page / YP listings (cosmetic).
# VDJ_ICECAST_HOSTNAME=virtual-dj
# Public host external players should connect to (e.g. 192.168.1.50, a DNS
# name, or a reverse-proxy hostname). Leave blank to use the host you opened
# the web UI from. This is only used to build the displayed URL in the web UI;
# it does NOT change how the container is reached (that's ICECAST_PORT + your
# network/DNS).
# ICECAST_PUBLIC_HOST=virtualdj.example.com
# Set to 0 to disable Icecast entirely (the web player still works).
VDJ_ICECAST_ENABLED=1

# NOTE: disabling this means a *change of default voice* leaves the DJ silent —
# the volume keeps the old voice and the TTS service has nothing for the
# configured one. The app says so at boot ("DJ voice not ready: ...") and in the
# web UI.
# First-run voice install. "0" = ask the TTS service to make the configured voice
# usable on first start (with the default supertonic3 engine that means fetching
# the ~400 MB model bundle from HuggingFace once, into the tts-models volume; the
# ten voices ship inside it). Set to "1" to skip (pre-populate the volume, or no
# network). Other voices/engines are installed on demand from the web UI
# (DJ Settings -> Voice), and `python -m app.voices --list` in the app container
# shows what the running engine offers.
VDJ_NO_VOICE_DOWNLOAD=0

# --- Speech synthesis service (container "tts") ---
# Where the app finds the service. Inside compose the default is the service
# name; point it at another host/port (or a different deployment entirely) to
# reuse the station against a remote voice service.
# VDJ_TTS_URL=http://tts:9000
# Host port the API is published on (loopback only, for curl/debugging).
TTS_PORT=9000
# Engine behind the API: supertonic3 (default) or piper. The app is unaffected
# by this choice — it asks the service what voices/languages/parameters exist
# and renders the DJ card from that answer.
TTS_ENGINE=supertonic3
# Diffusion steps for engines that have them. Deliberately fixed (not a UI
# knob): 5 is the measured sweet spot, and the engine's 2-step mode garbles
# words (54-77 % Russian WER vs 9-36 % at 5).
TTS_STEPS=5
# Languages advertised to the app (the station speaks these two).
TTS_LANGUAGES=en,ru
# Load (and download if missing) the model at service startup. "0" = load on the
# first synthesis request instead.
TTS_AUTOLOAD=1
TTS_AUTODOWNLOAD=1
# ONNX Runtime intra-op threads. 0/blank = let onnxruntime decide (recommended
# unless this host is shared with something else).
TTS_THREADS=0
# Service log verbosity: debug | info | warning | error.
TTS_LOG_LEVEL=info

# --- Volume normalization (loudness analysis) ---
# Every track is measured once in the background (EBU R128, first 120 s) and
# then streamed at a fixed per-track gain. This sets how many files are
# analyzed in parallel; each worker is one ffmpeg process. The default (2)
# keeps the box responsive while the station keeps streaming — raise it toward
# your CPU core count for a faster first pass. Measured on a 6-core host for
# 8,800 files: ~1 h at 2 workers, ~28 min at 4, ~24 min at 6 (scaling flattens
# past 4). It is a one-off pass: afterwards only new/changed files are measured.
# NOTE: the web UI's "Volume normalization" card can override this, and a value
# saved there (in data/config.json) wins over this .env default.
VDJ_LOUDNESS_WORKERS=2

# --- Pause the station when nobody is listening ---
# The station stops itself once no listener is connected — no decoding, no track
# consumed, no LLM DJ break written — and starts again the moment somebody tunes
# in. Listeners are counted both on the app's own /stream.mp3 (browser player,
# mpv, curl) and on the Icecast mount (Winamp, VLC, Sonos).
# "0" = keep playing to an empty room (the old behaviour).
VDJ_PAUSE_WITHOUT_LISTENERS=1
# Seconds to keep playing after the last listener leaves, so a player that
# reconnects is not a pause. 0 = stop immediately.
VDJ_LISTENER_GRACE_S=30
# How often Icecast is asked how many listeners its mount has. If Icecast does
# not answer, presence is UNKNOWN (not zero) and the music keeps playing.
VDJ_LISTENER_POLL_S=5

# --- Optional: Ollama for the talking DJ (omit to run music-only) ---
# To reach an Ollama on the Docker HOST from inside the container, use
# host-gateway (the container side of Docker's bridge to the host).
# These are passed into the container and become the LLM defaults. The web UI
# "LLM configuration" card can override them at runtime (saved to
# data/config.json, which wins over both .env and these defaults).
# VDJ_OLLAMA_URL=http://host-gateway:11434
# VDJ_OLLAMA_MODEL=qwen3.5:9b

# --- Advanced (rarely needed; defaults suit the bundled compose stack) ---
# Where the app looks for music INSIDE the container. Change it only together
# with the `volumes:` mapping in docker-compose.yml (the default /music matches
# the bundled `MUSIC_DIR:/music` mount). A path saved in the web UI's Library
# panel wins over this default.
# VDJ_MUSIC_DIR=/music
# Where app state lives inside the container: the named volume from compose.
# This is also the default parent for the voices (see voices_dir) and logs.
# VDJ_DATA_DIR=/data
# The SQLite database file. Default: $VDJ_DATA_DIR/vdj.sqlite3
# VDJ_DB_PATH=/data/vdj.sqlite3
# Bind address and port INSIDE the container. The compose `ports:` mapping
# (HTTP_PORT:8420) assumes 8420; change both together.
# VDJ_HOST=0.0.0.0
# VDJ_PORT=8420
