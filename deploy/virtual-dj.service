# Virtual DJ - systemd unit
# Install: sudo cp virtual-dj.service /etc/systemd/system/ &&
#          sudo systemctl daemon-reload && sudo systemctl enable --now virtual-dj
#
# Adjust User=, WorkingDirectory= and the ExecStart path to your install.

[Unit]
Description=Virtual DJ - always-on MP3 radio with a talking DJ
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vdj
WorkingDirectory=/opt/virtual-dj
ExecStart=/opt/virtual-dj/run.sh --host 0.0.0.0 --port 8420
Restart=on-failure
RestartSec=5
# The DJ voice model lives in data/voices/; keep it writable for updates.
ReadWritePaths=/opt/virtual-dj/data
Environment=VDJ_LOG_LEVEL=info

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
